# Cloudflare Pages header rules. Not served as a file.

# Applies everywhere, including the apex, which /*.html would miss.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Brand assets change rarely, but not never.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
/assets/*
  Cache-Control: public, max-age=604800

# HTML keeps the Pages default of max-age=0, must-revalidate, so a break in
# the case reaches the public immediately. There has been no break in the
# case since 1752.
